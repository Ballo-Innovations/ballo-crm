{
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm db:generate:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(pnpm db:seed:*)",
      "Bash(pnpm db:deploy:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(gh workflow run:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin stage:*)",
      "Bash(gh pr merge:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./deploy/.env)"
    ]
  }
}
