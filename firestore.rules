rules_version = '2';

// Canonical data model (see docs/database-schema.md):
//   users/{uid}
//   organizations/{orgId}
//   organizations/{orgId}/accounts/{accountId}
//   organizations/{orgId}/contacts/{contactId}
//   organizations/{orgId}/opportunities/{opportunityId}
//   organizations/{orgId}/tasks/{taskId}
//   organizations/{orgId}/contracts/{contractId}
//   organizations/{orgId}/campaigns/{campaignId}
//   organizations/{orgId}/activities/{activityId}
//   organizations/{orgId}/notifications/{notificationId}
//   organizations/{orgId}/auditLogs/{logId}
//   organizations/{orgId}/aiJobs/{jobId}
//   organizations/{orgId}/templates/{templateId}
//   organizations/{orgId}/analyticsCache/{cacheKey}
//   organizations/{orgId}/settings/{settingId}
//   organizations/{orgId}/integrations/{provider}   (BalloAds / Brutus AI credentials)
//
// Every mutating write goes through a Server Action using the Admin SDK, which bypasses these
// rules entirely. These rules exist to (a) allow safe direct reads from Client Components via
// the client SDK, and (b) act as defense-in-depth if a bug ever calls the client SDK to write.

function isSignedIn() {
  return request.auth != null;
}

function userDoc() {
  return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
}

function isOrgMember(orgId) {
  return isSignedIn() && userDoc().orgId == orgId;
}

function hasRole(orgId, roles) {
  return isOrgMember(orgId) && userDoc().role in roles;
}

function isOwnerOrAdmin(orgId) {
  return hasRole(orgId, ["owner", "admin"]);
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOrgMember(resource.data.orgId));
      // Profile fields only - role/orgId changes must go through a Server Action so membership
      // can't be self-escalated from the client.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.role == resource.data.role;
      allow create, delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow update: if isOwnerOrAdmin(orgId);
      allow create, delete: if false;

      match /accounts/{accountId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ["owner", "admin", "manager", "rep"]);
      }

      match /contacts/{contactId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ["owner", "admin", "manager", "rep"]);
      }

      match /opportunities/{opportunityId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ["owner", "admin", "manager", "rep"]);
      }

      match /tasks/{taskId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ["owner", "admin", "manager", "rep"]);
      }

      match /contracts/{contractId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ["owner", "admin", "manager"]);
      }

      match /campaigns/{campaignId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ["owner", "admin", "manager"]);
      }

      match /activities/{activityId} {
        allow read: if isOrgMember(orgId);
        // Activities are an append-only audit trail of what happened on an entity.
        allow create: if hasRole(orgId, ["owner", "admin", "manager", "rep"]);
        allow update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOrgMember(orgId) && resource.data.targetUserId == request.auth.uid;
        allow update: if isOrgMember(orgId) && resource.data.targetUserId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"]);
        allow create, delete: if false;
      }

      match /auditLogs/{logId} {
        // Written only by trusted server code via the Admin SDK (bypasses rules).
        allow read: if isOwnerOrAdmin(orgId);
        allow write: if false;
      }

      match /aiJobs/{jobId} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /templates/{templateId} {
        allow read: if isOrgMember(orgId);
        allow write: if hasRole(orgId, ["owner", "admin", "manager"]);
      }

      match /analyticsCache/{cacheKey} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /settings/{settingId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOwnerOrAdmin(orgId);
      }

      match /integrations/{provider} {
        // Contains encrypted developer API keys - server-only, never exposed to the client SDK.
        allow read, write: if false;
      }
    }
  }
}
