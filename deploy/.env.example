# Per-environment settings for deploy/compose.yml.
# Copy to /var/apps/ballocrm-<env>/deploy/.env on the host, fill in, then `chmod 600 .env`.
# Never commit a filled-in copy. Generate secrets with `openssl rand -hex 24`
# (hex only: POSTGRES_PASSWORD goes into a connection URL).

# dev | stage | prod
APP_ENV=dev
COMPOSE_PROJECT_NAME=ballocrm-dev
# dev-hackerthon-crm.balloinnovations.com | stage-hackerthon-crm.balloinnovations.com |
# hackerthon-crm.balloinnovations.com   (the API is served on api.<APP_HOST>)
APP_HOST=dev-hackerthon-crm.balloinnovations.com

POSTGRES_PASSWORD=
MINIO_ROOT_USER=ballocrm
MINIO_ROOT_PASSWORD=
S3_BUCKET=contracts

# 32+ characters, different in every environment
AUTH_SECRET=

# Brutus AI hub. Optional; blank key = template fallback.
# dev: brutus-dev, stage: brutus-staging, prod: brutus.balloads.com
BRUTUS_API_URL=https://brutus-dev.balloads.com
BRUTUS_API_KEY=

INTEGRATION_MODE=mock
INTEGRATIONS_URL=http://mock-integrations:4100
EMAIL_WEBHOOK_SECRET=

# BalloAds comms API (live mode only)
BALLOADS_API_URL=
BALLOADS_API_KEY=
BALLOADS_WEBHOOK_SECRET=
