# Copy to .env for local development (Prisma and docker-compose both read .env).
# Never commit .env or real secrets.

# local | dev | stage | prod. Deployed environments set this in deploy/.env.example.
APP_ENV=local

DATABASE_URL=postgresql://compass:compass@localhost:5432/compass
AUTH_SECRET=change-me-32-chars-minimum
NEXTAUTH_URL=http://localhost:3000

# MinIO (S3-compatible) - contract PDFs
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=contracts

# Brutus (Ballo AI hub) writes the narratives. Optional; blank key = template
# fallback (the LLM layer must never throw). Local and dev use brutus-dev.
BRUTUS_API_URL=https://brutus-dev.balloads.com
BRUTUS_API_KEY=

# mock | live
INTEGRATION_MODE=mock
INTEGRATIONS_URL=http://localhost:4100
EMAIL_WEBHOOK_SECRET=change-me

# BalloAds comms API (live mode only). Get the key from the team's private access doc;
# never commit it. See docs/02-architecture/04-integrations-adapters.md.
BALLOADS_API_URL=
BALLOADS_API_KEY=
BALLOADS_WEBHOOK_SECRET=
