# Copy to .env.local for local development. Never commit .env.local or real secrets.
# See docs/environment.md for what each variable does and where to get its value.

# ---------------------------------------------------------------------------
# Next.js / App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Firebase (client SDK — safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-only secrets — never expose to the browser)
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the \n escapes literal; lib/firebase/admin.ts unescapes them at runtime.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Vercel (populated automatically on Vercel; leave blank locally)
# ---------------------------------------------------------------------------
VERCEL_URL=
VERCEL_ENV=

# ---------------------------------------------------------------------------
# BalloAds Developer Portal API (messaging — SMS/WhatsApp/Email are OUT OF SCOPE
# to reimplement; BalloCRM only calls these endpoints). See docs/integrations.md.
# ---------------------------------------------------------------------------
BALLOADS_API_BASE_URL=https://api.balloads.com/v1/developer-portal
BALLOADS_DEVELOPER_API_KEY=

# ---------------------------------------------------------------------------
# Brutus AI (commercial intelligence: scoring, summarization, next-best-action)
# ---------------------------------------------------------------------------
BRUTUS_AI_API_BASE_URL=
BRUTUS_AI_API_KEY=

# ---------------------------------------------------------------------------
# Analytics & Logging (optional — leave blank to disable)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=
LOG_LEVEL=info
SENTRY_DSN=
